# ==========================================================
# S!aP — Apache/LiteSpeed config for static hosting (Hostinger shared hosting
# runs LiteSpeed with Apache-compatible .htaccess support). This app is 100%
# static (HTML/CSS/JS + vendored Three.js + local .glb/.jpg/.svg assets, no
# server-side code, no database) -- everything below is either a MIME-type
# fix, a performance win, or a "don't publish the internal dev files" guard,
# nothing that changes how the app behaves.
# ==========================================================

# ---------- correct MIME types for 3D assets ----------
# Browsers/Three.js's GLTFLoader don't actually need these (it parses the
# fetched bytes directly, ignoring Content-Type), but some hosts otherwise
# serve unknown extensions as text/plain or force a download prompt if a
# .glb/.hdr URL is opened directly -- set them explicitly so that never
# happens, and so any CDN/proxy in front of the site caches them correctly.
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType model/gltf+json .gltf
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType application/javascript .js .mjs
</IfModule>

# ---------- gzip/deflate compression for text assets ----------
# The bulk of the payload (vendored Three.js, app JS/CSS) is text; this
# cuts transfer size substantially with no code changes.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- browser caching for static, cache-busted assets ----------
# index.html/mobile.html reference every JS/CSS file with a `?v=N` query
# string that gets bumped on every content change (see those files), so a
# long cache lifetime here is safe -- a new version always has a new URL.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType model/gltf-binary "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ---------- don't expose the file listing of any folder ----------
Options -Indexes

# ---------- keep internal/dev-only material off the public site ----------
# In case the whole project folder (not just the app's own files) gets
# uploaded as-is: these are planning docs, the client-facing commercial
# offer/deck, and local conversion scripts -- none of it is loaded by the
# app, so blocking it can't break anything, and it keeps business-sensitive
# files (the PDF/PPTX in reference/) off the public web.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(docs|reference|tools)/ - [F,L]
  RewriteRule ^\.claude/ - [F,L]
</IfModule>
<FilesMatch "\.(md|ps1|py|bat|pyc)$">
  Require all denied
</FilesMatch>
